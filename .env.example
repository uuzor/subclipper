# --- QuickReel configuration ---------------------------------------------
# Copy to .env and fill in. Never commit real .env values.

# Core
QUICKREEL_ENV=local
QUICKREEL_DATA_DIR=./data
QUICKREEL_DATABASE_URL=sqlite+pysqlite:///./data/quickreel.db
QUICKREEL_CORS_ORIGINS=http://localhost:3000

# Queue. Leave broker URL empty to run Celery in eager (in-process) mode,
# which is what you want for local development and tests.
QUICKREEL_REDIS_URL=
QUICKREEL_TASK_ALWAYS_EAGER=true

# --- AI providers ---------------------------------------------------------
# Which implementation backs each pipeline stage.
#   transcription: auto | faster-whisper | fake
#   vision:        auto | gemini | fake
#   moment:        auto | llm | fake
QUICKREEL_TRANSCRIPTION_PROVIDER=auto
QUICKREEL_VISION_PROVIDER=auto
QUICKREEL_MOMENT_PROVIDER=auto

# When a real provider is chosen, a runtime failure degrades to the deterministic
# fake so one flaky stage does not sink the whole run. Set false in production so
# the run fails loudly instead of producing plausible-looking fake output.
QUICKREEL_ALLOW_PROVIDER_FALLBACK=true

# Whisper (speech recognition)
QUICKREEL_WHISPER_MODEL=base
QUICKREEL_WHISPER_DEVICE=cpu
QUICKREEL_WHISPER_COMPUTE_TYPE=int8

# Gemini (multimodal video understanding). The whole video is never uploaded;
# frames are sampled at this interval up to this many frames.
QUICKREEL_GEMINI_API_KEY=
QUICKREEL_GEMINI_MODEL=gemini-flash-lite-latest
QUICKREEL_VISION_TIMEOUT_SECONDS=300
QUICKREEL_VISION_MAX_FRAMES=24
QUICKREEL_VISION_FRAME_INTERVAL_SECONDS=30

# Generic LLM for moment reasoning (OpenAI-compatible chat completions).
# Long transcripts are sent as overlapping windows rather than one request.
QUICKREEL_LLM_BASE_URL=
QUICKREEL_LLM_API_KEY=
QUICKREEL_LLM_MODEL=
QUICKREEL_LLM_TIMEOUT_SECONDS=120
QUICKREEL_LLM_MAX_RETRIES=3
QUICKREEL_LLM_CHUNK_CHARS=12000
QUICKREEL_LLM_CHUNK_OVERLAP_SECONDS=30

# --- Rendering ------------------------------------------------------------
QUICKREEL_FFMPEG_BIN=ffmpeg
QUICKREEL_FFPROBE_BIN=ffprobe
QUICKREEL_RENDER_TIMEOUT_SECONDS=900

# Max upload size in megabytes
QUICKREEL_MAX_UPLOAD_MB=2048

# --- Remote URL ingestion -------------------------------------------------
# Users can submit a video link (YouTube, TikTok, Instagram, X, Vimeo, ...)
# instead of uploading a file. Downloads are performed by yt-dlp; install it
# with `pip install 'quickreel[download]'`.
QUICKREEL_URL_INGESTION_ENABLED=true

# Optional host allowlist, comma separated. Empty means "any public host",
# which is still subject to SSRF checks (private/loopback/link-local addresses
# are always refused). Set this to lock ingestion to known-good platforms, e.g.
#   QUICKREEL_ALLOWED_SOURCE_HOSTS=youtube.com,youtu.be,tiktok.com,instagram.com
QUICKREEL_ALLOWED_SOURCE_HOSTS=

# Cap the downloaded resolution. Clips render to 1080x1920, so pulling 4K
# source wastes bandwidth and disk.
QUICKREEL_DOWNLOAD_MAX_HEIGHT=1080
QUICKREEL_DOWNLOAD_TIMEOUT_SECONDS=1800

# For sites that require an authenticated session, point at a Netscape-format
# cookies file exported from your browser. Treat this file as a secret: it
# grants access to your account. Never commit it.
QUICKREEL_DOWNLOADER_COOKIES_FILE=
QUICKREEL_DOWNLOADER_PROXY=
