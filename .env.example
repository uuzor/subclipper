# --- QuickReel configuration ---------------------------------------------
# Copy to .env and fill in. Never commit real .env values.

# Core
QUICKREEL_ENV=local
QUICKREEL_DATA_DIR=./data
QUICKREEL_DATABASE_URL=sqlite+pysqlite:///./data/quickreel.db
QUICKREEL_CORS_ORIGINS=http://localhost:3000

# Serve the built frontend from this process (Vite output dir).
# Empty = API only. Set it to run the whole app on one origin:
#   QUICKREEL_FRONTEND_DIR=./frontend/dist
QUICKREEL_FRONTEND_DIR=

# Queue. Leave broker URL empty to run Celery in eager (in-process) mode,
# which is what you want for local development and tests.
QUICKREEL_REDIS_URL=
QUICKREEL_TASK_ALWAYS_EAGER=true

# --- AI providers ---------------------------------------------------------
# Which implementation backs each pipeline stage.
#   transcription: auto | faster-whisper | fake
#   vision:        auto | gemini | fake
#   moment:        auto | llm | fake
QUICKREEL_TRANSCRIPTION_PROVIDER=auto
QUICKREEL_VISION_PROVIDER=auto
QUICKREEL_MOMENT_PROVIDER=auto

# When a real provider is chosen, a runtime failure degrades to the deterministic
# fake so one flaky stage does not sink the whole run. Set false in production so
# the run fails loudly instead of producing plausible-looking fake output.
QUICKREEL_ALLOW_PROVIDER_FALLBACK=true

# Whisper (speech recognition)
QUICKREEL_WHISPER_MODEL=base
QUICKREEL_WHISPER_DEVICE=cpu
QUICKREEL_WHISPER_COMPUTE_TYPE=int8

# Gemini (multimodal video understanding). The whole video is never uploaded;
# frames are sampled at this interval up to this many frames.
QUICKREEL_GEMINI_API_KEY=
QUICKREEL_GEMINI_MODEL=gemini-flash-lite-latest
QUICKREEL_VISION_TIMEOUT_SECONDS=300
QUICKREEL_VISION_MAX_FRAMES=24
QUICKREEL_VISION_FRAME_INTERVAL_SECONDS=30

# Generic LLM for moment reasoning (OpenAI-compatible chat completions).
# Long transcripts are sent as overlapping windows rather than one request.
QUICKREEL_LLM_BASE_URL=
QUICKREEL_LLM_API_KEY=
QUICKREEL_LLM_MODEL=
QUICKREEL_LLM_TIMEOUT_SECONDS=120
QUICKREEL_LLM_MAX_RETRIES=3
QUICKREEL_LLM_CHUNK_CHARS=12000
QUICKREEL_LLM_CHUNK_OVERLAP_SECONDS=30

# --- Rendering ------------------------------------------------------------
QUICKREEL_FFMPEG_BIN=ffmpeg
QUICKREEL_FFPROBE_BIN=ffprobe
QUICKREEL_RENDER_TIMEOUT_SECONDS=900

# Max upload size in megabytes
QUICKREEL_MAX_UPLOAD_MB=2048

# --- Remote URL ingestion -------------------------------------------------
# Users can submit a video link (YouTube, TikTok, Instagram, X, Vimeo, ...)
# instead of uploading a file. Downloads are performed by yt-dlp; install it
# with `pip install 'quickreel[download]'`.
QUICKREEL_URL_INGESTION_ENABLED=true

# Optional host allowlist, comma separated. Empty means "any public host",
# which is still subject to SSRF checks (private/loopback/link-local addresses
# are always refused). Set this to lock ingestion to known-good platforms, e.g.
#   QUICKREEL_ALLOWED_SOURCE_HOSTS=youtube.com,youtu.be,tiktok.com,instagram.com
QUICKREEL_ALLOWED_SOURCE_HOSTS=

# Cap the downloaded resolution. Clips render to 1080x1920, so pulling 4K
# source wastes bandwidth and disk.
QUICKREEL_DOWNLOAD_MAX_HEIGHT=1080
QUICKREEL_DOWNLOAD_TIMEOUT_SECONDS=1800

# For sites that require an authenticated session, point at a Netscape-format
# cookies file exported from your browser. Treat this file as a secret: it
# grants access to your account. Never commit it.
QUICKREEL_DOWNLOADER_COOKIES_FILE=
QUICKREEL_DOWNLOADER_PROXY=

# --- Publishing / scheduling ------------------------------------------------
# "mock" resolves every platform to the deterministic mock adapter so the whole
# scheduling loop runs with no credentials or network access. "live" requires a
# registered real adapter and never falls back silently.
QUICKREEL_PUBLISHING_MODE=mock

# Retry policy. A transient failure is rescheduled with exponential backoff from
# this base, capped by the ceiling so a throttled post cannot drift days out.
# A platform-supplied retry-after always wins over the computed delay.
QUICKREEL_PUBLISH_MAX_ATTEMPTS=5
QUICKREEL_PUBLISH_RETRY_BASE_SECONDS=60
QUICKREEL_PUBLISH_MAX_BACKOFF_SECONDS=3600

# --- OAuth (connect a publishing account) -----------------------------------
# The externally reachable origin. Redirect URIs are built from it and the
# platform rejects any mismatch with what is registered in its developer
# console, so in production this must be the verified domain exactly.
QUICKREEL_PUBLIC_BASE_URL=http://localhost:12000

# Signs the OAuth ``state`` parameter. Without it an attacker can hand a victim
# a callback URL and silently attach the attacker's account to the victim's
# workspace (login CSRF). Required in production; the app refuses to start
# without it there.
QUICKREEL_OAUTH_STATE_SECRET=

# Per-platform client credentials, issued when an app is created in the
# platform's developer console. Empty means the connect flow reports "not
# configured" rather than sending the user to an error page. See
# docs/app-review/ for how each of these is obtained.
QUICKREEL_TIKTOK_CLIENT_ID=
QUICKREEL_TIKTOK_CLIENT_SECRET=
QUICKREEL_INSTAGRAM_REELS_CLIENT_ID=
QUICKREEL_INSTAGRAM_REELS_CLIENT_SECRET=
QUICKREEL_YOUTUBE_SHORTS_CLIENT_ID=
QUICKREEL_YOUTUBE_SHORTS_CLIENT_SECRET=

# --- YouTube ingestion trigger (WebSub / PubSubHubbub) ----------------------
# Subscribing to a channel makes the hub push a notification when it publishes,
# which starts a project for the new video. No OAuth scope is involved: the
# basis for processing a channel is the authorization recorded on the
# subscription, not a platform grant.
QUICKREEL_YOUTUBE_HUB_URL=https://pubsubhubbub.appspot.com/subscribe

# Shared secret appended to the callback URL and echoed by the hub during the
# verification handshake. The callback is public and WebSub does not sign
# notifications, so this plus the channel allowlist is what authenticates one.
# Required in production.
QUICKREEL_YOUTUBE_CALLBACK_SECRET=

# Optional. When set, a notification must carry a matching X-Hub-Signature.
# Only useful if the hub actually signs; PubSubHubbub does not by default.
QUICKREEL_YOUTUBE_SIGNING_SECRET=

# Renew a subscription once it is within this many seconds of expiring. Leases
# lapse silently, and when one does the trigger simply stops firing.
QUICKREEL_YOUTUBE_RENEW_BEFORE_SECONDS=86400

# Ignore videos shorter than this: there is nothing to clip out of them.
QUICKREEL_YOUTUBE_MIN_DURATION_SECONDS=90

# Shorts are already short-form, so clipping them is not the job.
QUICKREEL_YOUTUBE_SKIP_SHORTS=true

# A new video creates a draft for review by default. Auto-processing is opt-in,
# because an unattended pipeline that spends money and publishes without a human
# is not something to switch on by default.
QUICKREEL_YOUTUBE_AUTO_SCHEDULE=false
